VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional server-side aliases if you do not want to reuse the VITE_ values in Vercel:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Existing shared engagement database connection:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Optional: comma-separated allowlist for true admin access
AUTH_ADMIN_EMAILS=you@example.com
